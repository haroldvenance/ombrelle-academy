# ─────────────────────────────────────────────────────────────────
# OMBRELLE Academy — variables d'environnement
#
# Copiez ce fichier en .env.local et remplacez les valeurs.
# ⚠️  Ne JAMAIS committer .env.local ni de vraies clés dans .env.example.
# ─────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Application ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=contact@ombrelle-academy.com

# ─── Paiement manuel ─────────────────────────────────────────────
# Instructions affichées à l'étudiant sur la page /paiement/[id]
NEXT_PUBLIC_PAYMENT_INSTRUCTIONS="Orange Money / MTN MoMo : 6XX XX XX XX (OMBRELLE). Indiquez votre email en motif, puis soumettez la référence de transaction."